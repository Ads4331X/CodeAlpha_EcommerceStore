# Database (Postgres - use Neon, Supabase, Render, Vercel Postgres, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Local dev alternatives if you have local MySQL
# DB_HOST=localhost
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=ecommerce_db
# PORT=5000

# Email / SMTP
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# Auth
JWT_SECRET=change_me_to_a_secure_random_string
JWT_EXPIRES_IN=7d

# Metal rates (optional)
METALS_API_KEY=

# Payments
ESEWA_SECRET=
KHALTI_SECRET=
KHALTI_GATEWAY_URL=https://dev.khalti.com

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Vercel Blob (for product images)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
